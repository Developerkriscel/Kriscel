# Kriscel Tech - Backend Environment Variables Template
# Copy this to .env in production and fill in the actual values

# Port for the server to listen on
PORT=5000

# development or production
NODE_ENV=production

# Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/kriscel?retryWrites=true&w=majority

# The URL of your FRONTEND (no trailing slash)
# Used for CORS security
# Example: https://kriscel-tech.vercel.app
CLIENT_URL=https://your-production-frontend-url.com

# Secure secret for JWT tokens (Change this to a long random string!)
JWT_SECRET=your_super_secret_production_key_change_me
