# Backend (Express) production environment
NODE_ENV=production
PORT=5000

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/kriscel?retryWrites=true&w=majority

# Allowed frontend origin for CORS (exact origin)
CLIENT_URL=https://www.yourdomain.com

# Use a long random secret, 32+ chars
JWT_SECRET=replace_with_a_long_random_secret
